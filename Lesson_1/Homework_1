# Задаем исходные числа (можно менять на 0 или 1)
A = 1
B = 0
C = 1

print(f"Исходные числа: A = {A}, B = {B}, C = {C}")
print("-" * 30)

# Выражение 1: ¬(A ∧ B) ∨ ¬(A ∨ C)
# Маска & 1 превращает ~0 в 1, а ~1 в 0
expr1 = (~(A & B) & 1) | (~(A | C) & 1)
print("Результат выражения 1:", expr1)

# Выражение 2: (A ∧ B) ∨ (¬B ∧ C)
expr2 = (A & B) | ((~B & 1) & C)
print("Результат выражения 2:", expr2)

# Выражение 3: (A ∧ B) ∨ ¬C
expr3 = (A & B) | (~C & 1)
print("Результат выражения 3:", expr3)
